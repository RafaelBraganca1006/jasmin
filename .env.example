# Copie este arquivo para .env.local e preencha com sua key.
# Pegue uma key gratuita em: https://console.groq.com/keys
GROQ_API_KEY=

# (opcional) Troque o modelo sem mexer no código se o Groq aposentar o atual:
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_TRANSCRIPTION=whisper-large-v3

# (opcional) Fallback grátis quando o Groq bate o limite (429) ou cai: o prontuário, a guia e o
# chat passam a usar o OpenRouter. Key em: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# LLM_FORCE_FALLBACK=1   # pula o Groq (só para testar o fallback)
